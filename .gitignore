# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]64/
[Ll]og/
[Ll]ogs/
*.binlog

# IDE and user files
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.user
*.suo
*.userprefs
*.rsuser
