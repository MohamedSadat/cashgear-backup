# OS
Thumbs.db
Desktop.ini
.DS_Store

# Pinned Kopia binary: fetched by tools/kopia/fetch-kopia.ps1, never committed
/tools/kopia/kopia.exe
/tools/kopia/*.tmp

# Local run output (spike HTTP captures, logs)
/artifacts/

# Kopia's plaintext password fallback must never be committed
*.kopia-password
