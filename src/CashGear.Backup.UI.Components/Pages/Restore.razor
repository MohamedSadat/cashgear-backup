@page "/jobs/{JobId}/restore"
@implements IDisposable
@inject IAgentClient Agent
@inject IDesktopShell Shell
@inject TimeProvider Time

@* Restore: pick a restore point, browse it, pick what to restore, restore into a new or empty folder. Never overwrites. *@

<div class="page-head">
    <h1>Restore files@(_job is null ? "" : $" from {_job.Spec.Name}")</h1>
    <a class="button" href="">Back to backups</a>
</div>

<ErrorBox Message="@_loadError" />

@if (_snapshot is null)
{
    @if (_snapshots is not null)
    {
        <p>Choose the restore point to restore from.</p>
        <label class="choice">
            <input type="checkbox" id="show-incomplete" @bind="_showIncomplete" />
            Show incomplete restore points (from canceled or interrupted backups)
        </label>
        @if (VisibleSnapshots.Count == 0)
        {
            <p class="muted">No restore points yet. They appear after the first backup.</p>
        }
        else
        {
            <table class="snapshots">
                <thead>
                    <tr><th>Taken</th><th class="num">Files</th><th class="num">Size</th><th>Notes</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var snapshot in VisibleSnapshots)
                    {
                        <tr class="snapshot">
                            <td>@Format.When(snapshot.EndTime ?? snapshot.StartTime, Time)</td>
                            <td class="num">@Format.Count(snapshot.Files, "file", "files")</td>
                            <td class="num">@Format.Bytes(snapshot.Bytes)</td>
                            <td>
                                @if (!snapshot.Complete)
                                {
                                    <span class="badge badge-warn">Incomplete</span>
                                    <span class="muted">@snapshot.IncompleteReason</span>
                                }
                                @if (snapshot.FailedItemCount > 0)
                                {
                                    <span class="badge badge-warn">@Format.Count(snapshot.FailedItemCount, "item", "items") skipped</span>
                                }
                            </td>
                            <td><button type="button" class="button choose" @onclick="() => Choose(snapshot)">Browse</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else if (_loadError is null)
    {
        <p class="muted">Loading…</p>
    }
}
else
{
    <p class="chosen">
        Restore point: <strong>@Format.When(_snapshot.EndTime ?? _snapshot.StartTime, Time)</strong>
        <button type="button" class="link" @onclick="BackToList" disabled="@_busy">Choose another</button>
    </p>

    <SnapshotBrowser JobId="@JobId" SnapshotId="@_snapshot.Id" @bind-Folder="_folder" @bind-Selected="_selected" Disabled="_busy" />

    <section class="restore-panel">
        <p class="selection">Restore: <strong>@SelectionText</strong></p>
        <div class="field">
            <label for="restore-target">Into folder</label>
            <FolderField Id="restore-target" Title="Choose a new or empty folder to restore into" @bind-Value="_target" Disabled="_busy" />
        </div>
        <p id="restore-note" class="hint">CashGear Backup restores into a new or empty folder and never overwrites existing files.</p>
        <ElevationNote />
        <ErrorBox Message="@_error" />

        @if (_progress is not null)
        {
            <RunProgressView Progress="_progress" Kind="RunKind.Restore" />
        }
        else if (_finished is not null)
        {
            <div id="restore-result" class="result result-@RunStates.Tone(_finished.State)">
                <RunStateBadge State="_finished.State" />
                <p>@ResultText(_finished)</p>
                <FailedItems Run="_finished" />
                @if (_finished.State is RunState.Succeeded or RunState.CompletedWithWarnings or RunState.Canceled)
                {
                    <button type="button" id="open-folder" class="button" @onclick="() => Shell.OpenFolder(_finished.RestoreTarget)">Open folder</button>
                }
            </div>
        }

        <button type="button" id="start-restore" class="button primary" @onclick="StartAsync" disabled="@_busy">Restore</button>
    </section>
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private Job? _job;
    private IReadOnlyList<Snapshot>? _snapshots;
    private bool _showIncomplete;
    private Snapshot? _snapshot;
    private string _folder = "";
    private string _selected = "";
    private string _target = "";
    private RunProgress? _progress;
    private Run? _finished;
    private string? _loadError;
    private string? _error;
    private bool _busy;

    [Parameter]
    public string JobId { get; set; } = "";

    /// <summary>Newest first. Partial snapshots (a canceled run) are never offered by default.</summary>
    private List<Snapshot> VisibleSnapshots => [.. (_snapshots ?? []).Where(s => s.Complete || _showIncomplete)];

    private string SelectionText => _selected.Length == 0 ? "everything in this restore point" : _selected;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _job = (await Agent.ListJobsAsync(_cts.Token)).FirstOrDefault(j => j.Id == JobId);
            if (_job is null)
            {
                _loadError = "This backup job no longer exists.";
                return;
            }

            _snapshots = await Agent.ListSnapshotsAsync(JobId, _cts.Token);
        }
        catch (AgentCallException ex)
        {
            _loadError = ErrorText.For(ex);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
    }

    private void Choose(Snapshot snapshot)
    {
        _snapshot = snapshot;
        _folder = "";
        _selected = "";
        _target = Path.Combine(Shell.DefaultRestoreParent, $"{SafeName(_job!.Spec.Name)} {Format.Stamp(snapshot.EndTime ?? snapshot.StartTime, Time)}");
        _progress = null;
        _finished = null;
        _error = null;
    }

    private void BackToList()
    {
        _snapshot = null;
        _finished = null;
        _error = null;
    }

    private async Task StartAsync()
    {
        _error = null;
        _finished = null;
        var target = _target.Trim();
        if (target.Length == 0 || !Path.IsPathFullyQualified(target))
        {
            _error = "Choose the folder to restore into: a full path such as C:\\Users\\you\\Restored.";
            return;
        }

        _busy = true;
        try
        {
            var run = await Agent.StartRestoreAsync(new StartRestoreRequest
            {
                JobId = JobId,
                SnapshotId = _snapshot!.Id,
                Path = _selected,
                TargetFolder = target,
            }, _cts.Token);
            _progress = new RunProgress { RunId = run.Id, State = run.State };
            _ = FollowAsync(run.Id, _cts.Token);
        }
        catch (AgentCallException ex)
        {
            _error = ErrorText.For(ex);
            _busy = false;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
        }
    }

    /// <summary>Follows the restore to its end; the page stays usable (and leavable) meanwhile.</summary>
    private async Task FollowAsync(string runId, CancellationToken ct)
    {
        try
        {
            await foreach (var update in Agent.WatchRunAsync(runId, ct))
            {
                await InvokeAsync(() =>
                {
                    if (update.Finished is { } finished)
                    {
                        _finished = finished;
                    }
                    else
                    {
                        _progress = update;
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (AgentCallException ex)
        {
            _error = ErrorText.For(ex);
        }

        await InvokeAsync(() =>
        {
            _progress = null;
            _busy = false;
            StateHasChanged();
        });
    }

    private static string ResultText(Run run) => run.State switch
    {
        RunState.Succeeded => $"Restored {Format.Count(run.Files, "file", "files")} ({Format.Bytes(run.Bytes)}) into {run.RestoreTarget}.",
        RunState.CompletedWithWarnings => $"Restored {Format.Count(run.Files, "file", "files")} into {run.RestoreTarget}, but some items could not be restored.",
        RunState.Canceled => $"The restore was canceled. What was restored so far is in {run.RestoreTarget}.",
        _ => $"The restore failed. {run.Message}",
    };

    private static string SafeName(string name)
    {
        var invalid = Path.GetInvalidFileNameChars();
        return new string([.. name.Select(c => invalid.Contains(c) ? '_' : c)]).Trim();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
