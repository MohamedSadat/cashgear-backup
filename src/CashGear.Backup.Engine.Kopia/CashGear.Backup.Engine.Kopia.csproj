<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only project that knows Kopia exists: process host, REST client, DTOs, policy mapping. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- LibraryImport (Job Object P/Invoke) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CashGear.Backup.Engine.Kopia.IntegrationTests" />
  </ItemGroup>

  <!-- The pin is compiled into the assembly, so swapping kopia.exe and the pin file on disk is not enough. -->
  <ItemGroup>
    <EmbeddedResource Include="$(CashGearKopiaDir)kopia.pin.json" LogicalName="CashGear.Backup.Engine.Kopia.kopia.pin.json" Link="Hosting\kopia.pin.json" />
  </ItemGroup>

  <!-- Copies the pinned kopia.exe next to every app and test that references the engine (the default
       KopiaBackupEngineFactory.BundledExecutablePath). Skipped until tools/kopia/fetch-kopia.ps1 has run. -->
  <ItemGroup Condition="Exists('$(CashGearKopiaDir)kopia.exe')">
    <None Include="$(CashGearKopiaDir)kopia.exe" Link="kopia.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashGear.Backup.Core\CashGear.Backup.Core.csproj" />
  </ItemGroup>

</Project>
