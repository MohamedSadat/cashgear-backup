<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- WPF host: BlazorWebView with the UI.Components pages, tray icon, single instance. The same exe, started
       with "runas" and the elevated-helper switch, is the headless helper that makes Manage calls. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A versioned Windows TFM: BlazorWebView's WebView2 composition control needs the Windows SDK projection
         (Microsoft.Windows.SDK.NET), which plain net10.0-windows does not ship. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <StartupObject>CashGear.Backup.Desktop.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashGear.Backup.UI.Components\CashGear.Backup.UI.Components.csproj" />
    <ProjectReference Include="..\CashGear.Backup.Client\CashGear.Backup.Client.csproj" />
    <ProjectReference Include="..\CashGear.Backup.Contracts\CashGear.Backup.Contracts.csproj" />
  </ItemGroup>

</Project>
